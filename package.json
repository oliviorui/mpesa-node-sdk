{
  "name": "mpesa-node-sdk",
  "version": "0.1.0",
  "description": "A TypeScript SDK for M-Pesa payments in Mozambique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify":"npm run test:run && npm run build && npm run typecheck",
    "test": "node scripts/run-vitest.mjs",
    "test:run": "node scripts/run-vitest.mjs run",
    "example:mock": "npm run build && node examples/mock-payment.mjs"
  },
  "keywords": [
    "mpesa",
    "mozambique",
    "payments",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.8",
    "vitest": "4.1"
  }
}
